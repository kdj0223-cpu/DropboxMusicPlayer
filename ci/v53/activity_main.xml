<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nudeong_bg"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="누덩이 뮤직 ♪"
                android:textColor="@color/nudeong_text"
                android:textSize="31sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="좋은 음악이 있는 하루"
                android:textColor="@color/nudeong_text_muted"
                android:textSize="15sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="새로고침"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_notifications"
            app:iconTint="@color/nudeong_primary_dark"
            app:iconSize="25dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            app:cardBackgroundColor="#F6E5D4"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/nudeong_phone"
                android:contentDescription="설정"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeTabs"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeDropbox"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:checked="true"
            android:text="▣  Dropbox"
            android:textAllCaps="false"
            android:textColor="@color/nudeong_text"
            android:textSize="17sp"
            app:backgroundTint="@color/nudeong_secondary"
            app:cornerRadius="28dp"
            app:strokeColor="@color/nudeong_outline"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeYoutube"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▶  YouTube"
            android:textAllCaps="false"
            android:textColor="@color/nudeong_text"
            android:textSize="17sp"
            app:backgroundTint="@color/nudeong_panel_soft"
            app:cornerRadius="28dp"
            app:strokeColor="@color/nudeong_outline"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:boxBackgroundColor="@color/nudeong_panel"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:boxStrokeColor="@color/nudeong_outline"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_music_note"
        app:startIconTint="@color/nudeong_primary_dark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="곡 검색"
            android:singleLine="true"
            android:textColor="@color/nudeong_text"
            android:textColorHint="@color/nudeong_text_muted"
            android:textSize="17sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/playlistTabs"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllTracks"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="전체 곡"
            android:textColor="@color/nudeong_text"
            android:textSize="16sp"
            app:backgroundTint="@color/nudeong_secondary"
            app:cornerRadius="26dp"
            app:strokeColor="@color/nudeong_outline"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorites"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="즐겨찾기"
            android:textColor="@color/nudeong_text"
            android:textSize="16sp"
            app:backgroundTint="@color/nudeong_panel_soft"
            app:cornerRadius="26dp"
            app:strokeColor="@color/nudeong_outline"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#F8E8D7"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="155dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:text="오늘도
좋은 음악과
함께해요 ♪"
                android:textColor="@color/nudeong_primary_dark"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="190dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/nudeong_phone"
                android:contentDescription="휴대폰을 든 누덩이"/>

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="누덩이와
음악 듣는
좋은 하루 ♡"
                android:textColor="@color/nudeong_text_muted"
                android:textSize="15sp"/>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:text="MP3 0곡 · Dropbox"
        android:textColor="@color/nudeong_text_muted"
        android:textSize="13sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="108dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/nudeong_panel"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/nudeong_outline"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F6E5D4">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/nudeong_couch"
                    android:contentDescription="누덩이"/>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="재생 중인 곡 없음"
                    android:textColor="@color/nudeong_text"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/miniSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dropbox"
                    android:textColor="@color/nudeong_text_muted"
                    android:textSize="13sp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiniPlay"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:backgroundTint="@color/nudeong_primary"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/white"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiniNext"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_skip_next"
                app:iconTint="@color/nudeong_primary_dark"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>