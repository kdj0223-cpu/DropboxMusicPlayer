<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="94dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/nudeong_panel"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#F0E3D4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="82dp"
            android:layout_height="74dp"
            app:cardBackgroundColor="#FFF2E3"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/trackArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/nudeong_phone"
                android:contentDescription="누덩이" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="너와 듣고 싶은 노래"
                android:textColor="@color/nudeong_text"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="10CM · YouTube"
                android:textColor="@color/nudeong_text_muted"
                android:textSize="14sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavoriteTrack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="즐겨찾기"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_favorite_border"
            app:iconTint="@color/nudeong_primary_dark"
            app:iconSize="28dp"/>

        <TextView
            android:layout_width="28dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/nudeong_primary_dark"
            android:textSize="24sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>